# Database Configuration (PostgreSQL / Cloud SQL)
DATABASE_URL="postgresql://user:password@localhost:5432/mykuhli_db?schema=public"

# Authentication & Security
AUTH_SECRET="your-super-secret-jwt-key-change-in-production-min32chars"

# Third-Party Integrations & Services
EMAIL_API_KEY="re_sample_api_key_or_sendgrid"
STORAGE_API_KEY="sample_cloud_storage_bucket_key"
PAYMENT_API_KEY="sample_payment_provider_secret_key"

# Gemini API Key (Server-side)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

